{
    "name": "jeffersongoncalves/laravel-gdpr-audit-log",
    "description": "GDPR accountability for Laravel (Art. 5(2)): tamper-evident, hash-chained log of who viewed, changed, exported or erased personal data.",
    "keywords": [
        "laravel",
        "gdpr",
        "audit-log",
        "accountability",
        "hash-chain",
        "personal-data",
        "privacy"
    ],
    "homepage": "https://github.com/jeffersongoncalves/laravel-gdpr-audit-log",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Jefferson Simão Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\GdprAuditLog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\GdprAuditLog\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\GdprAuditLog\\GdprAuditLogServiceProvider"
            ],
            "aliases": {
                "GdprAuditLog": "JeffersonGoncalves\\GdprAuditLog\\Facades\\GdprAuditLog"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
